# GigaChat API credentials
# Скопируйте сюда значение из поля "Authorization Key" в личном кабинете Сбера
GIGACHAT_CREDENTIALS=your_authorization_key_here(API)

GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Lightning

# Minimum cosine similarity score for semantic event search (0.0–1.0)
TTV_MIN_SIMILARITY=0.80
